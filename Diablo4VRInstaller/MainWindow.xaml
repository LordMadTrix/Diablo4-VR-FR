<Window x:Class="Diablo4VRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DIABLO IV VR - Installateur &amp; Optimiseur Diorama 3D (Édition Française) • LordMadTrix"
        Height="720" Width="850" MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#080406"
        Foreground="#F5E6E8"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BloodRed" Color="#E50914" />
        <SolidColorBrush x:Key="RunicGold" Color="#D4AF37" />
        <SolidColorBrush x:Key="CardBg" Color="#120A0E" />
        <SolidColorBrush x:Key="CardBorder" Color="#2A121A" />

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="BloodButton" TargetType="Button">
            <Setter Property="Background" Value="#A80710" />
            <Setter Property="Foreground" Value="#FFF0F0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D60A16" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#7A050B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource BloodButton}">
            <Setter Property="Background" Value="#B8860B" />
            <Setter Property="Foreground" Value="#1A1202" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D4AF37" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#8B6508" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1016" />
            <Setter Property="Foreground" Value="#D4AF37" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#381822" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0C0609" BorderBrush="#261019" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚔️ DIABLO IV VR" FontSize="20" FontWeight="Black" Foreground="#E50914" />
                        <Border Background="#D4AF37" CornerRadius="4" Padding="7,2" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DIORAMA 3D OPENXR" FontSize="10" FontWeight="Bold" Foreground="#120A0E" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Sanctuaire en Maquette Vivante Stéréoscopique 3D &amp; Immersion Gothique" FontSize="12" Foreground="#A89098" Margin="0,3,0,0" />
                    <TextBlock x:Name="TxtGpuInfo" Text="🔍 Détection GPU..." FontSize="11" Foreground="#D4AF37" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#160B10" BorderBrush="#381822" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="✍ Signé LordMadTrix" FontSize="11" FontWeight="Bold" Foreground="#D4AF37" />
                </Border>
            </Grid>
        </Border>

        <!-- Corps principal -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,10,14,0">
            <StackPanel>

                <!-- Carte : Aperçu visuel en jeu -->
                <Border Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True">
                    <Grid Height="140">
                        <Image Source="assets/vr_preview.png" Stretch="UniformToFill" />
                        <Border Background="#99090406" VerticalAlignment="Bottom" Padding="12,6">
                            <TextBlock Text="👁️ Aperçu Vue Casque VR : Rendu Diorama 3D Stéréoscopique à profondeur volumétrique" FontSize="11" Foreground="#FFD700" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Carte : Répertoire de jeu -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="📁 DOSSIER DU JEU (DIABLO IV)" FontWeight="Bold" FontSize="12" Foreground="#E50914" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGamePath" Grid.Column="0" Background="#0A0407" Foreground="#FFF0F0" BorderBrush="#381822" BorderThickness="1" Padding="8,6" FontSize="12" TextChanged="TxtGamePath_TextChanged" />
                            <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="BtnBrowse_Click" />
                            <Button Grid.Column="2" Content="📂 Ouvrir" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="BtnOpenFolder_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtDetectStatus" Text="🔍 Recherche de Diablo IV.exe..." FontSize="11" Foreground="#D4AF37" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Carte : DLSS & Super-Résolution IA -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="⚡ UPSCALING IA &amp; DLSS DERNIÈRE GÉNÉRATION" FontWeight="Bold" FontSize="12" Foreground="#FFD700" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkDlss" Content="Activer NVIDIA DLSS / DLAA &amp; Super-Résolution Ultra Haute Fidélité (Anti-scintillement VR)" IsChecked="True" Foreground="#F5E6E8" Margin="0,2,0,4" />
                        <CheckBox x:Name="ChkFrameGen" Content="Activer DLSS Frame Generation pour fluidité 120 FPS stable (RTX série 40 / 30)" IsChecked="True" Foreground="#F5E6E8" Margin="0,2,0,4" />
                    </StackPanel>
                </Border>

                <!-- Carte : Casque VR -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🥽 CASQUE VR DÉTECTÉ :" FontWeight="Bold" FontSize="12" Foreground="#E50914" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border x:Name="BadgeCasque" Grid.Column="1" Background="#261019" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtCasqueBadge" Text="❌ Aucun client VR détecté" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B" />
                            </Border>
                        </Grid>
                        <CheckBox x:Name="ChkQuest3Opt" Content="Optimisation Quest 3 (Wi-Fi 6, 120Hz, Encodage H.265 ALVR/WiVRn)" IsChecked="True" Foreground="#D4AF37" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Carte : Profils Diorama 3D -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="🎭 PROFONDEUR DIORAMA 3D &amp; CAMÉRA" FontWeight="Bold" FontSize="12" Foreground="#E50914" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioDioramaImmersion" Grid.Column="0" Content="Diorama Standard (Profondeur naturelle)" IsChecked="True" Foreground="#F5E6E8" Margin="2" />
                            <RadioButton x:Name="RadioDioramaIntense" Grid.Column="1" Content="Diorama Profond (Relief 3D accentué)" Foreground="#F5E6E8" Margin="2" />
                            <RadioButton x:Name="RadioDioramaCinematic" Grid.Column="2" Content="Vue Plongeante Maquette (Tilt-Shift)" Foreground="#F5E6E8" Margin="2" />
                        </Grid>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="Créer le raccourci Bureau 'Diablo IV VR (FR)'" IsChecked="True" Foreground="#F5E6E8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Console de déploiement -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="📋 CONSOLE DE DÉPLOIEMENT" FontWeight="Bold" FontSize="11" Foreground="#A89098" Margin="0,0,0,4" />
                        <ProgressBar x:Name="ProgressBar" Height="6" Background="#0A0407" Foreground="#E50914" BorderBrush="#261019" Margin="0,0,0,6" />
                        <ListBox x:Name="LogConsole" Height="90" Background="#050203" BorderBrush="#261019" RequestBringIntoView="LogConsole_RequestBringIntoView" FontSize="11" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Boutons d'action en bas -->
        <Border Grid.Row="2" Background="#080406" BorderBrush="#261019" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnInstall" Grid.Column="0" Content="⚡ INSTALLER DIABLO IV VR (FR)" Style="{StaticResource BloodButton}" Margin="0,0,8,0" Click="BtnInstall_Click" />
                <Button x:Name="BtnLaunch" Grid.Column="1" Content="🚀 LANCER EN VR" Style="{StaticResource GoldButton}" Padding="16,10" Margin="0,0,8,0" Click="BtnLaunch_Click" />
                <Button x:Name="BtnUninstall" Grid.Column="2" Content="Restaurer Vanilla" Style="{StaticResource DarkButton}" Click="BtnUninstall_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
